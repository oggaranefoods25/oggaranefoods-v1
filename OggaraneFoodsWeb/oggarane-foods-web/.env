# SMTP Configuration
# This is the email account that will SEND emails on behalf of your website
# Anyone can still use the contact form - this is just the "from" address
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=oggaranefoods@gmail.com
SMTP_PASS=hjna khel tqhh iyyd

# Contact Email
# This is where contact form submissions will be DELIVERED
CONTACT_EMAIL=oggaranefoods@gmail.com

# Server Configuration
PORT=3001
NODE_ENV=development

# Instructions for Gmail SMTP Setup:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password as SMTP_PASS (not your regular password)
# 4. Update SMTP_USER with your Gmail address (this will be the "from" address)
# 5. Update CONTACT_EMAIL with the email where you want to receive contact form submissions
#
# IMPORTANT: SMTP_USER is the account that SENDS emails, not who can USE the contact form.
# Anyone can fill out the contact form - this just determines which email account
# will be used to send the emails from your website.
